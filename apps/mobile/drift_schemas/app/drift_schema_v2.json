  "fixed_sql": [
    {
      "name": "ledger_ops",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ledger_ops\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"txn_id\" TEXT NOT NULL UNIQUE, \"op_type\" TEXT NOT NULL CHECK(\"op_type\" IN ('trip_start', 'trip_result', 'ad_reward', 'spend_jenehat', 'spend_bonat', 'use_booster')), \"payload\" TEXT NOT NULL, \"jenehat_delta\" INTEGER NOT NULL DEFAULT 0, \"bonat_delta\" INTEGER NOT NULL DEFAULT 0, \"fuel_delta\" INTEGER NOT NULL DEFAULT 0, \"reason\" TEXT NULL, \"ref\" TEXT NULL, \"occurred_at_ms\" INTEGER NOT NULL, \"content_version\" INTEGER NOT NULL CHECK(\"content_version\" >= 1), \"fuel_max\" INTEGER NOT NULL CHECK(\"fuel_max\" >= 1), \"fuel_regen_minutes\" INTEGER NOT NULL CHECK(\"fuel_regen_minutes\" >= 1), \"max_earnings_jenehat\" INTEGER NULL CHECK(\"max_earnings_jenehat\" >= 0), \"sync_status\" TEXT NOT NULL DEFAULT 'pending' CHECK(\"sync_status\" IN ('pending', 'accepted', 'rejected')), \"sync_reason\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "wallet",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wallet\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"jenehat\" INTEGER NOT NULL CHECK(\"jenehat\" >= 0), \"bonat\" INTEGER NOT NULL CHECK(\"bonat\" >= 0), \"fuel\" INTEGER NOT NULL CHECK(\"fuel\" >= 0), \"fuel_counted_from_ms\" INTEGER NOT NULL, \"fuel_unlimited_until_ms\" INTEGER NULL, \"last_seq\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "inventory",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inventory\" (\"booster_id\" TEXT NOT NULL CHECK(\"booster_id\" IN ('change_bag', 'wake_all', 'ledger_peek', 'traffic_jam')), \"count\" INTEGER NOT NULL CHECK(\"count\" >= 0), PRIMARY KEY (\"booster_id\"));"
        }
      ]
    },
    {
      "name": "ownership",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ownership\" (\"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('item', 'vehicle', 'chapter')), \"sku_id\" TEXT NOT NULL, \"variant_id\" TEXT NULL, \"acquired_at_ms\" INTEGER NOT NULL, \"acquired_by\" TEXT NOT NULL, PRIMARY KEY (\"kind\", \"sku_id\"));"
        }
      ]
    },
    {
      "name": "trip_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_progress\" (\"trip_id\" TEXT NOT NULL, \"best_stars\" INTEGER NOT NULL CHECK(\"best_stars\" BETWEEN 0 AND 3), \"best_time_ms\" INTEGER NULL, \"plays\" INTEGER NOT NULL CHECK(\"plays\" >= 0), \"first_completed_at_ms\" INTEGER NULL, PRIMARY KEY (\"trip_id\"));"
        }
      ]
    },
    {
      "name": "trip_session",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_session\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"unfinished_start\" TEXT NULL, \"unfinished_trip_id\" TEXT NULL, \"unfinished_content_version\" INTEGER NULL, \"unfinished_max_earnings\" INTEGER NULL, \"unfinished_started_at_ms\" INTEGER NULL, \"unfinished_revived\" INTEGER NULL CHECK (\"unfinished_revived\" IN (0, 1)), \"unfinished_traffic_jam_ads\" INTEGER NULL, \"last_result_start\" TEXT NULL, \"last_result_outcome\" TEXT NULL, \"last_result_earnings\" INTEGER NULL, \"last_result_doubled\" INTEGER NULL CHECK (\"last_result_doubled\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "projection_base",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projection_base\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"state\" TEXT NOT NULL, \"after_seq\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('new_player', 'server_snapshot')), \"state_version\" INTEGER NULL, \"taken_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "clock_anchor",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"clock_anchor\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"anchor_ms\" INTEGER NOT NULL, \"anchor_elapsed_ms\" INTEGER NOT NULL, \"boot_count\" INTEGER NULL, \"source\" TEXT NOT NULL CHECK(\"source\" IN ('device', 'server')), \"latest_trusted_ms\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "trip_record",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_record\" (\"start_txn\" TEXT NOT NULL, \"trip_id\" TEXT NOT NULL, \"content_version\" INTEGER NOT NULL, \"definition_json\" TEXT NOT NULL, \"seed\" INTEGER NOT NULL, \"params_json\" TEXT NOT NULL, \"t_ms\" INTEGER NOT NULL, \"created_at_ms\" INTEGER NOT NULL, PRIMARY KEY (\"start_txn\"));"
        }
      ]
    },
    {
      "name": "trip_record_command",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_record_command\" (\"start_txn\" TEXT NOT NULL, \"seq\" INTEGER NOT NULL, \"command_json\" TEXT NOT NULL, PRIMARY KEY (\"start_txn\", \"seq\"));"
        }
      ]
    },
    {
      "name": "trip_intent",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"trip_intent\" (\"request_txn\" TEXT NOT NULL, \"start_txn\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('use_booster')), \"booster\" TEXT NOT NULL, PRIMARY KEY (\"request_txn\"));"
        }
      ]
    },
    {
      "name": "ledger_ops_sync",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX ledger_ops_sync ON ledger_ops (sync_status, seq)"
        }
      ]
    },
    {
      "name": "ledger_ops_ref",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX ledger_ops_ref ON ledger_ops (ref)"
        }
      ]
    }
  ]
