# Development configuration for the backend (specs/002-b01-backend-skeleton/contracts/environment.md).
# Copy to backend/.env. Every secret here is a `change-me-` placeholder, which only `dev` accepts.
#
# The URLs below point at 127.0.0.1 for commands run on the host (uv run manage.py …, pytest).
# The dev containers override them with the compose service names (docker/compose.dev.yml).
# If you change a dev password here, export the same value before `docker compose up`
# (for example `export WASSAL_DB_PASSWORD=…`), because compose.dev.yml reads it from the shell.
# The dev database is on 5433, beside a native PostgreSQL's 5432. If 5433 or 6379 is taken on your
# machine, export WASSAL_DEV_PG_PORT or WASSAL_DEV_VALKEY_PORT before `docker compose up`, and use
# the same port in the URLs below.

DJANGO_SETTINGS_MODULE=config.settings.dev
WASSAL_ENV=dev
DJANGO_DEBUG=true
SECRET_KEY=change-me-dev-secret-key-not-for-staging-or-production-0000
RELEASE=dev
LOG_LEVEL=INFO

DATABASE_URL=postgres://wassal:change-me-db@127.0.0.1:5433/wassal
CACHE_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1

API_HOST=localhost
ADMIN_HOST=localhost
NUM_PROXIES=0

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
THROTTLE_ADDRESS_RATE=120/min
HC_PING_HEARTBEAT_URL=

# Content pipeline (specs/003-b04-content-pipeline/contracts/environment.md). On the host the packs
# directory defaults to backend/var/packs (gitignored). The dev containers use the `packs` volume at
# /var/lib/wassal/packs instead (docker/compose.dev.yml). CONTENT_SOLVER_STAGE=solver runs the real
# solver (B05), which staging and prod use by default; `stand_in` passes every trip and is refused
# outside dev and test.
CONTENT_ROLE=source
CONTENT_PACKS_PUBLIC_URL=http://localhost:8000/packs/
CONTENT_SOLVER_STAGE=stand_in
CONTENT_MANIFEST_CACHE_SECONDS=30
CONTENT_HTTP_TIMEOUT_SECONDS=10

# Accounts and auth (specs/009-b02-accounts-auth/contracts/environment.md). AUTH_SIGNING_KEYS is a
# comma-separated `kid:key` ring, first signs; staging and prod take theirs from
# `uv run manage.py auth_signing_key`. GOOGLE_OAUTH_CLIENT_IDS empty turns Google linking off here
# until you add the dev web client id.
AUTH_SIGNING_KEYS=dev1:change-me-dev-signing-key-0000000000000000000000000
AUTH_REFRESH_RETRY_SECONDS=60
AUTH_MAX_SESSIONS_PER_PLAYER=10
AUTH_HTTP_TIMEOUT_SECONDS=5
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_KEYS_CACHE_SECONDS=3600
THROTTLE_PLAYER_RATE=120/min
THROTTLE_ANONYMOUS_RATE=60/hour
THROTTLE_REFRESH_RATE=30/min
THROTTLE_LINK_RATE=10/min

# Economy, bootstrap and sync: what B03 kept in the environment (B10 research R4). The timezone
# is a contract with the phone and the retention sizes the database; every balancing number is a
# live setting now (apps/liveops/registry.py).
SYNC_GAME_TIMEZONE=Africa/Cairo
SYNC_OP_RETENTION_DAYS=180
THROTTLE_SYNC_RATE=60/min
CONTENT_INDEX_KEEP=10

# B10 (specs/016-b10-catalog-offers/contracts/environment.md): how old a process's settings
# snapshot may get, and the optional Remote Config drift check (both empty = not configured).
LIVEOPS_REFRESH_SECONDS=30
FIREBASE_PROJECT_ID=
REMOTE_CONFIG_SERVICE_ACCOUNT=

# Ads (specs/017-b07-ads-ssv/contracts/environment.md). The dev stack reads the key list that
# `uv run manage.py ads_dev_callback` writes on first use (backend/.dev/, gitignored); staging and
# prod read Google's. `file://` is refused outside dev and test, `http://` outside dev and test too.
ADS_VERIFIER_KEYS_URL=file:///app/.dev/admob_verifier_keys.json
ADS_KEYS_CACHE_SECONDS=86400
ADS_HTTP_TIMEOUT_SECONDS=5
THROTTLE_SSV_RATE=600/min
# The AdMob ad unit ids whose callbacks may grant (digits, comma-separated). Empty lets every unit
# through in dev and test only; staging and prod grant nothing until it is set in /etc/wassal/<env>.env.
ADS_ALLOWED_AD_UNITS=

# Database container (docker/postgres/initdb/01-app-role.sh)
POSTGRES_PASSWORD=change-me-postgres
WASSAL_DB_PASSWORD=change-me-db

# pytest on the host, against the real PostgreSQL and Valkey (constitution XIII)
TEST_DATABASE_URL=postgres://postgres:change-me-postgres@127.0.0.1:5433/postgres
TEST_CACHE_URL=redis://127.0.0.1:6379/2
TEST_BROKER_URL=redis://127.0.0.1:6379/3
