# Production sizing for compose interpolation (research R1 "Memory budget", data-model "Environment").
# Not secret. Secrets live in /etc/wassal/prod.env and /etc/wassal/prod-db.env on the server.
API_PORT=8100
ADMIN_PORT=8101
APP_ENV_FILE=/etc/wassal/prod.env
DB_ENV_FILE=/etc/wassal/prod-db.env
# The deploy script keeps this filled from the serving release (contracts/operations.md).
POSTGRES_INITDB_DIR=/var/lib/wassal/prod/initdb
# The backup job's own directory and env file (contracts/operations.md "Backup job").
BACKUP_STATE_DIR=/var/lib/wassal/prod/backup
BACKUP_ENV_FILE=/etc/wassal/prod-backup.env
POSTGRES_MEM_LIMIT=1024m
VALKEY_MEM_LIMIT=256m
API_MEM_LIMIT=768m
ADMIN_MEM_LIMIT=384m
WORKER_MEM_LIMIT=512m
BEAT_MEM_LIMIT=192m
