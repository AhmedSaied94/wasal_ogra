# Staging sizing for compose interpolation (research R1 "Memory budget", data-model "Environment").
# Not secret. Secrets live in /etc/wassal/staging.env and /etc/wassal/staging-db.env on the server.
API_PORT=8200
ADMIN_PORT=8201
APP_ENV_FILE=/etc/wassal/staging.env
DB_ENV_FILE=/etc/wassal/staging-db.env
# The deploy script keeps this filled from the serving release (contracts/operations.md).
POSTGRES_INITDB_DIR=/var/lib/wassal/staging/initdb
# The backup job's own directory and env file (contracts/operations.md "Backup job").
BACKUP_STATE_DIR=/var/lib/wassal/staging/backup
BACKUP_ENV_FILE=/etc/wassal/staging-backup.env
API_WORKERS=1
POSTGRES_SHARED_BUFFERS=128MB
VALKEY_MAXMEMORY=80mb
POSTGRES_MEM_LIMIT=512m
VALKEY_MEM_LIMIT=128m
API_MEM_LIMIT=384m
ADMIN_MEM_LIMIT=256m
WORKER_MEM_LIMIT=384m
BEAT_MEM_LIMIT=192m
# B10 (specs/016-b10-catalog-offers/contracts/environment.md). The two Firebase values stay empty
# until the owner creates the read-only service account; the check then reports not_configured.
LIVEOPS_REFRESH_SECONDS=30
FIREBASE_PROJECT_ID=
REMOTE_CONFIG_SERVICE_ACCOUNT=
# B07 (specs/017-b07-ads-ssv/contracts/environment.md): Google's AdMob verifier keys and the
# callback's limit per address.
ADS_VERIFIER_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADS_KEYS_CACHE_SECONDS=86400
ADS_HTTP_TIMEOUT_SECONDS=5
THROTTLE_SSV_RATE=600/min
