#!/usr/bin/env bash
# The nightly backup (FR-039, contracts/operations.md "Backup job"), run by wassal-backup@prod.timer:
#
#   /opt/wassal/bin/backup prod
#
# It runs `python manage.py backup_db` in the serving release's image, with that release's own stack
# definition and sizing file, as deploy does. The command pings Healthchecks.io itself. If this
# script can't start it, the check's grace period raises the alert.
#
# Exit codes: 0 backed up; 1 the backup failed (backup_db pinged /fail); 2 bad input or setup;
# 3 a deploy held the lock.
set -euo pipefail

# The image's `app` user (docker/Dockerfile), which owns the backup's state directory.
APP_UID="${WASSAL_APP_UID:-10001}"
APP_GID="${WASSAL_APP_GID:-$APP_UID}"
readonly LOCK_TIMEOUT=900
STATE_DIR="${WASSAL_STATE_DIR:-/var/lib/wassal}"
ETC_DIR="${WASSAL_ETC:-/etc/wassal}"
LOCK_DIR="${WASSAL_LOCK_DIR:-/run/lock}"

log() { echo "backup: $*" >&2; }
die() { log "$*"; exit 2; }

if [ $# -ne 1 ] || ! [[ "$1" =~ ^(staging|prod)$ ]]; then die "usage: backup <staging|prod>"; fi
ENV="$1"
ENV_STATE="$STATE_DIR/$ENV"
BACKUP_ENV_FILE="$ETC_DIR/$ENV-backup.env"

[ -f "$BACKUP_ENV_FILE" ] || die "$BACKUP_ENV_FILE is missing (monitoring-setup.md, Backblaze B2)"
TAG="$(cat "$ENV_STATE/release" 2>/dev/null)" || die "no release serves $ENV yet"
[[ "$TAG" =~ ^(sha-[0-9a-f]{40}|v[0-9]+\.[0-9]+\.[0-9]+)$ ]] || die "the release file is invalid"
STACK="$ENV_STATE/deploy/$TAG"
if [ ! -f "$STACK/compose.yml" ] || [ ! -f "$STACK/env/$ENV.env" ]; then
  die "the serving release's stack definition is missing"
fi

# One at a time with deploy: a release switch never happens under a running backup.
exec 9>"$LOCK_DIR/wassal-deploy-$ENV.lock"
flock -w "$LOCK_TIMEOUT" 9 || { log "a deploy held the lock for ${LOCK_TIMEOUT}s"; exit 3; }

# The container writes last-backup.json here, and nowhere else on the host: the rest of
# $ENV_STATE holds the stack definitions that root runs.
install -d -m 0750 -o "$APP_UID" -g "$APP_GID" "$ENV_STATE/backup"

status=0
RELEASE_TAG="$TAG" BACKUP_ENV_FILE="$BACKUP_ENV_FILE" BACKUP_STATE_DIR="$ENV_STATE/backup" \
  docker compose -p "wassal-$ENV" -f "$STACK/compose.yml" --env-file "$STACK/env/$ENV.env" \
  --profile ops run --rm --no-deps -T backup || status=$?
if [ "$status" -ne 0 ]; then
  log "backup_db failed (exit $status)"
  exit 1
fi
