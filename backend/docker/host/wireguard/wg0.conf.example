# WireGuard server (research R8, contracts/operations.md). provision.sh copies this to
# /etc/wireguard/wg0.conf (0600) on its first run and fills in the host's WireGuard address
# (host.env's WG_ADDRESS) and the key. Peers are added only with `wg-peer add`, which saves them
# here through `wg-quick save`.
[Interface]
Address = @WG_ADDRESS@/24
ListenPort = 51820
PrivateKey = @SERVER_PRIVATE_KEY@
