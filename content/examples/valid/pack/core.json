  "speech_pools": [
    {
      "lines": [
        {
          "text": {
            "ar-EG": "إنت بتتهمني؟ أنا دافع يا أسطى!"
          }
        },
        {
          "text": {
            "ar-EG": "عيب كده، أنا دفعت"
          }
        }
      ],
      "speech_key": "passenger.accused"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "أيوه يا أسطى؟ معاك"
          }
        },
        {
          "text": {
            "ar-EG": "بتكلمني أنا؟"
          }
        }
      ],
      "speech_key": "passenger.attentive"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "السلام عليكم"
          }
        },
        {
          "text": {
            "ar-EG": "صباح الخير يا أسطى"
          }
        }
      ],
      "speech_key": "passenger.boards"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "خلاص خلاص، أهو دافع"
          }
        },
        {
          "text": {
            "ar-EG": "طب ماشي، اتفضل"
          }
        }
      ],
      "speech_key": "passenger.caught"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "معاك فكة {amount} يا أسطى؟"
          }
        },
        {
          "text": {
            "ar-EG": "ممكن تفكّلي {amount}؟"
          }
        }
      ],
      "speech_key": "passenger.change_request"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "ماشي، خلّيها"
          }
        },
        {
          "text": {
            "ar-EG": "يعني مفيش فكة خالص؟"
          }
        }
      ],
      "speech_key": "passenger.change_request_declined"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "أنا دافع يا أسطى!"
          }
        },
        {
          "text": {
            "ar-EG": "والله دفعت من بدري"
          }
        }
      ],
      "speech_key": "passenger.claims_paid"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "هو اللي ما دفعش!"
          }
        },
        {
          "text": {
            "ar-EG": "أنا دافع، اسأله هو"
          }
        }
      ],
      "speech_key": "passenger.dispute"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "نزّلني هنا يا أسطى"
          }
        },
        {
          "text": {
            "ar-EG": "على جنب هنا لو سمحت"
          }
        }
      ],
      "speech_key": "passenger.drop_me_here"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "يعني أنزل من غير باقي؟ لسه ليّا {amount}!"
          }
        },
        {
          "text": {
            "ar-EG": "فين الـ{amount} بتوعي يا أسطى؟"
          }
        }
      ],
      "speech_key": "passenger.fight"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "إيه يا أسطى، الباقي هييجي إمتى؟"
          }
        },
        {
          "text": {
            "ar-EG": "أنا مستعجل ولسه ما خدتش الباقي!"
          }
        }
      ],
      "speech_key": "passenger.impatient"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "يا نهار! فاتتني {station}"
          }
        },
        {
          "text": {
            "ar-EG": "مش كان المفروض أنزل في {station}؟"
          }
        }
      ],
      "speech_key": "passenger.missed_stop"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "اتفضل يا أسطى الأجرة"
          }
        },
        {
          "text": {
            "ar-EG": "خد يا أسطى، من غير باقي"
          }
        }
      ],
      "speech_key": "passenger.pays"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "خد يا أسطى، عنّي وعن صحابي"
          }
        },
        {
          "text": {
            "ar-EG": "الأجرة دي عننا كلنا"
          }
        }
      ],
      "speech_key": "passenger.pays_group"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "هي الأجرة زادت؟ أنا معايا ده بس"
          }
        },
        {
          "text": {
            "ar-EG": "أنا دافع زي كل يوم يا أسطى"
          }
        }
      ],
      "speech_key": "passenger.pays_old_fare"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "خد الباقي اللي عليّا يا أسطى"
          }
        },
        {
          "text": {
            "ar-EG": "حقك، كمّلتلك {amount}"
          }
        }
      ],
      "speech_key": "passenger.pays_rest"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "إديتني زيادة يا أسطى، خد {amount}"
          }
        },
        {
          "text": {
            "ar-EG": "الحلال حلال، دول {amount} زيادة"
          }
        }
      ],
      "speech_key": "passenger.returns_excess"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "لسه ليّا {amount} يا أسطى"
          }
        },
        {
          "text": {
            "ar-EG": "الباقي ناقص {amount}"
          }
        }
      ],
      "speech_key": "passenger.short_change"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "على {station} لو سمحت"
          }
        },
        {
          "text": {
            "ar-EG": "نزّلني عند {station} يا أسطى"
          }
        }
      ],
      "speech_key": "passenger.stop_near"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "تسلم يا أسطى"
          }
        },
        {
          "text": {
            "ar-EG": "متشكرين يا ريّس"
          }
        }
      ],
      "speech_key": "passenger.thanks"
    },
    {
      "lines": [
        {
          "text": {
            "ar-EG": "خلّي {amount} عشانك"
