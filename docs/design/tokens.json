  "color_rules": [
    "danger (#F2542D) never carries white text: text on danger is ink. Use danger.ink (#C23A17) for danger-coloured text on white.",
    "icon.off is for icons only, never for text (contrast).",
    "Locked cards: background locked.bg + inset 2px outline ring + text ink.2. Never fade content with opacity.",
    "Disabled buttons: 45% opacity and no lip."
