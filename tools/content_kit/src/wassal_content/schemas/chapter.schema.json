{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wassal.invalid/content/1/chapter.schema.json",
  "title": "Chapter",
  "description": "A story chapter: its savings goal and its comic scenes.",
  "type": "object",
  "required": [
    "chapter_id",
    "order",
    "title",
    "goal",
    "completion_bonat",
    "scenes"
  ],
  "properties": {
    "chapter_id": {
      "$ref": "common.schema.json#/$defs/ChapterId"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "common.schema.json#/$defs/LocalizedText"
    },
    "goal": {
      "$ref": "#/$defs/ChapterGoal"
    },
    "story_trip_id": {
      "$ref": "common.schema.json#/$defs/TripId"
    },
    "completion_bonat": {
      "$ref": "common.schema.json#/$defs/Amount"
    },
    "goal_art": {
      "$ref": "common.schema.json#/$defs/Slug"
    },
    "goal_line": {
      "$ref": "#/$defs/CharacterLine"
    },
    "ready_line": {
      "$ref": "common.schema.json#/$defs/LocalizedText"
    },
    "tagline": {
      "$ref": "common.schema.json#/$defs/LocalizedText"
    },
    "story_trip_info": {
      "$ref": "#/$defs/StoryTripInfo"
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Scene"
      },
      "minItems": 0,
      "maxItems": 10
    }
  },
  "additionalProperties": false,
  "$defs": {
    "GoalKind": {
      "description": "What finishes a chapter.",
      "type": "string",
      "enum": [
        "complete_line",
        "own_vehicle",
        "purchase",
        "complete_room"
      ]
    },
    "ChapterGoal": {
      "description": "A chapter's goal: complete_line needs line_id, own_vehicle vehicle_id, complete_room room_id, purchase none (its price is in the catalog).",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/GoalKind"
        },
        "line_id": {
          "$ref": "common.schema.json#/$defs/LineId"
        },
        "vehicle_id": {
          "$ref": "common.schema.json#/$defs/VehicleId"
        },
        "room_id": {
          "$ref": "common.schema.json#/$defs/RoomId"
        }
      },
      "additionalProperties": false
    },
    "Scene": {
      "description": "A comic scene of 3 to 5 panels.",
      "type": "object",
      "required": [
        "scene_id",
        "title",
        "panels"
      ],
      "properties": {
        "scene_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,31}$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/LocalizedText"
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Panel"
          },
          "minItems": 3,
          "maxItems": 5
        },
        "plays": {
          "$ref": "#/$defs/ScenePlays"
        }
      },
      "additionalProperties": false
    },
    "ScenePlays": {
      "description": "When the app plays the scene by itself. Absent: when the chapter's goal is met (M10).",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/ScenePlaysKind"
        },
        "trip_id": {
          "$ref": "common.schema.json#/$defs/TripId"
        }
      },
      "additionalProperties": false
    },
    "ScenePlaysKind": {
      "description": "opening: at the first open, before the Name card. after_trip: right after the trip's first finish.",
      "type": "string",
      "enum": [
        "opening",
        "after_trip"
      ]
    },
    "Panel": {
      "description": "One comic panel: its art and its lines.",
      "type": "object",
      "required": [
        "art",
        "lines"
      ],
      "properties": {
        "art": {
          "$ref": "common.schema.json#/$defs/Slug"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PanelLine"
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "additionalProperties": false
    },
    "PanelLine": {
      "description": "A line of dialogue in a panel.",
      "type": "object",
      "required": [
        "speaker",
        "text"
      ],
      "properties": {
        "speaker": {
          "$ref": "common.schema.json#/$defs/Slug"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/LocalizedText"
        }
      },
      "additionalProperties": false
    },
    "CharacterLine": {
      "description": "A character's line on a screen (the goal card).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speaker",
        "text"
      ],
      "properties": {
        "speaker": {
          "$ref": "common.schema.json#/$defs/StoryCharacter"
        },
        "text": {
          "$ref": "common.schema.json#/$defs/LocalizedText"
        }
      }
    },
    "StoryTripInfo": {
      "description": "How the chapter's story trip is presented: who rides, its title and condition (M10).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "riders"
      ],
      "properties": {
        "title": {
          "$ref": "common.schema.json#/$defs/LocalizedText"
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/LocalizedText"
        },
        "fail_reason": {
          "$ref": "common.schema.json#/$defs/LocalizedText"
        },
        "riders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StoryRider"
          },
          "minItems": 1,
          "maxItems": 2
        }
      }
    },
    "StoryRider": {
      "description": "A story character riding in a seat the trip leaves empty.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "seat"
      ],
      "properties": {
        "character": {
          "$ref": "common.schema.json#/$defs/StoryCharacter"
        },
        "seat": {
          "$ref": "common.schema.json#/$defs/SeatId"
        },
        "comments": {
          "$ref": "#/$defs/RiderComments"
        }
      }
    },
    "RiderComments": {
      "description": "The speech pool a rider draws from, per mistake.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "short_change": {
          "$ref": "common.schema.json#/$defs/SpeechKey"
        },
        "false_accusation": {
          "$ref": "common.schema.json#/$defs/SpeechKey"
        },
        "fight": {
          "$ref": "common.schema.json#/$defs/SpeechKey"
        },
        "missed_stop": {
          "$ref": "common.schema.json#/$defs/SpeechKey"
        },
        "impatient": {
          "$ref": "common.schema.json#/$defs/SpeechKey"
        }
      }
    }
  }
}
