{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wassal.invalid/content/1/common.schema.json",
  "description": "Shared definitions for every content schema (schema set 1.0).",
  "$defs": {
    "Piasters": {
      "description": "An amount of trip cash in piasters: an integer multiple of 50 (1 EGP = 100).",
      "type": "integer",
      "minimum": 0,
      "multipleOf": 50
    },
    "PositivePiasters": {
      "description": "A trip-cash amount of at least one 50-piaster coin.",
      "type": "integer",
      "minimum": 50,
      "multipleOf": 50
    },
    "Denomination": {
      "description": "A coin or note, in piasters (glossary 3.2).",
      "type": "integer",
      "enum": [
        50,
        100,
        500,
        1000,
        2000,
        5000,
        10000,
        20000
      ]
    },
    "DenominationKey": {
      "description": "A denomination written as a map key.",
      "type": "string",
      "enum": [
        "50",
        "100",
        "500",
        "1000",
        "2000",
        "5000",
        "10000",
        "20000"
      ]
    },
    "Amount": {
      "description": "An amount of JENEHAT or BONAT.",
      "type": "integer",
      "minimum": 0
    },
    "LocalizedText": {
      "description": "Player-visible text per locale: ar-EG is required, ar is optional.",
      "type": "object",
      "required": [
        "ar-EG"
      ],
      "properties": {
        "ar-EG": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "Slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,47}$",
      "description": "A lowercase slug, for example an art reference."
    },
    "LineId": {
      "description": "A line (glossary 3.6).",
      "type": "string",
      "enum": [
        "line_hay",
        "line_gamaa",
        "line_souq",
        "line_masyaf",
        "line_safar"
      ]
    },
    "VehicleId": {
      "description": "A vehicle (glossary 3.6).",
      "type": "string",
      "enum": [
        "tuktuk",
        "micro_old",
        "micro_new",
        "micro_safar"
      ]
    },
    "ChapterId": {
      "description": "A story chapter (glossary 3.6).",
      "type": "string",
      "enum": [
        "ch1_first_job",
        "ch2_her_father",
        "ch3_shabka",
        "ch4_salon",
        "ch5_kitchen",
        "ch6_bedroom",
        "ch7_wedding"
      ]
    },
    "RoomId": {
      "description": "An apartment room (glossary 3.6).",
      "type": "string",
      "enum": [
        "salon",
        "kitchen",
        "bedroom"
      ]
    },
    "StoryCharacter": {
      "description": "A story character (the design's character ids).",
      "type": "string",
      "enum": [
        "usta",
        "salma",
        "bride_father",
        "bride_mother",
        "moallem",
        "belya"
      ]
    },
    "Archetype": {      "description": "A passenger behavior (glossary 3.6).",
      "type": "string",
      "enum": [
        "regular",
        "hajja",
        "sleeper",
        "hurry",
        "big_note",
        "student",
        "headphones",
        "false_claimer",
        "group_payer",
        "chatty",
        "money_changer",
        "bags_lady",
        "dodger",
        "mother_kids",
        "big_family",
        "traveler",
        "regular_customer",
        "honest"
      ]
    },
    "EventId": {
      "description": "An in-trip event (glossary 3.6).",
      "type": "string",
      "enum": [
        "bump",
        "traffic",
        "open_road",
        "fare_increase",
        "drop_me_here",
        "payment_dispute",
        "change_request",
        "roadside_pickup"
      ]
    },
    "BoosterId": {
      "description": "A booster or BONAT product (glossary 3.3).",
      "type": "string",
      "enum": [
        "change_bag",
        "wake_all",
        "ledger_peek",
        "traffic_jam",
        "revive",
        "refuel_full",
        "fuel_unlimited_1h"
      ]
    },
    "Currency": {
      "description": "A soft or premium currency (glossary 3.1).",
      "type": "string",
      "enum": [
        "JENEHAT",
        "BONAT"
      ]
    },
    "TripId": {
      "type": "string",
      "pattern": "^line_[a-z]+\\.[0-9]{2}$",
      "description": "<line_id>.<nn>, for example line_gamaa.12."
    },
    "StationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,31}$",
      "description": "A station, unique within its line."
    },
    "SeatId": {
      "type": "string",
      "pattern": "^(front|[A-D])_(r|m|l)$",
      "description": "<row>_<col>: row front or A-D, col r, m or l."
    },
    "ItemId": {
      "type": "string",
      "pattern": "^(salon|kitchen|bedroom)\\.[a-z][a-z0-9_]{1,31}$",
      "description": "<room_id>.<slug>, for example salon.nish."
    },
    "SpeechKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
      "maxLength": 64,
      "description": "The key of a speech pool, for example passenger.pays."
    },
    "ClientVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "An app version, major.minor.patch."
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "A lowercase hex SHA-256."
    }
  }
}
